; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="PokeCompanion"
config/version="0.86"
run/main_scene="res://scenes/main/companion.tscn"
config/features=PackedStringArray("4.7", "GL Compatibility")
run/max_fps=30
run/low_processor_mode=true
config/icon="uid://c5iftjno2ymmt"

[autoload]

EventBus="*res://scripts/autoload/event_bus.gd"
Settings="*res://scripts/autoload/settings.gd"
GameData="*res://scripts/autoload/game_data.gd"
PlayerState="*res://scripts/autoload/player_state.gd"
SaveManager="*res://scripts/autoload/save_manager.gd"
UnlockManager="*res://scripts/autoload/unlock_manager.gd"
EncounterManager="*res://scripts/autoload/encounter_manager.gd"
ExpeditionManager="*res://scripts/autoload/expedition_manager.gd"
ShopManager="*res://scripts/autoload/shop_manager.gd"
ProfessorManager="*res://scripts/autoload/professor_manager.gd"
EvolutionManager="*res://scripts/autoload/evolution_manager.gd"
AudioManager="*res://scripts/autoload/audio_manager.gd"
WindowManager="*res://scripts/autoload/window_manager.gd"

[display]

window/size/viewport_width=448
window/size/viewport_height=200
window/size/resizable=false
window/size/borderless=true
window/stretch/mode="viewport"
window/stretch/scale_mode="integer"

[editor_plugins]

enabled=PackedStringArray("res://addons/gdUnit4/plugin.cfg")

[gui]

theme/custom="res://Assets/UI/main_theme.tres"

[physics]

3d/physics_engine="Jolt Physics"

[rendering]

textures/canvas_textures/default_texture_filter=0
renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
